{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-evolution-protocol.local/schemas/task-envelope-v2.schema.json",
  "title": "AEP Task Envelope v2",
  "type": "object",
  "required": ["schema", "task_id", "workspace_id", "goal", "phase", "next_action", "acceptance"],
  "properties": {
    "schema": {"const": "aep-task-envelope-v2"},
    "task_id": {"type": "string", "minLength": 1},
    "workspace_id": {"type": "string", "minLength": 8},
    "goal": {"type": "string", "minLength": 1},
    "phase": {"enum": ["discover", "debate", "execute", "verify", "handoff", "done", "blocked"]},
    "next_action": {"type": "string", "minLength": 1},
    "acceptance": {"type": "array", "minItems": 1},
    "assignees": {"type": "array", "items": {"type": "string"}},
    "evidence": {"type": "array", "items": {"type": "string"}},
    "constraints": {"type": "array"}
  },
  "additionalProperties": true
}
