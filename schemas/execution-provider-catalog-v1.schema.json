{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-evolution-protocol.dev/schemas/execution-provider-catalog-v1.schema.json",
  "title": "AEP execution provider catalog v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "purpose", "provenance_policy", "providers"],
  "properties": {
    "schema": {"const": "aep-execution-provider-catalog-v1"},
    "purpose": {"type": "string", "minLength": 1},
    "provenance_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["default_license_status", "default_distribution_mode", "notice_policy"],
      "properties": {
        "default_license_status": {"const": "unverified"},
        "default_distribution_mode": {"const": "reference-only"},
        "notice_policy": {"type": "string", "minLength": 1}
      }
    },
    "providers": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/provider"}
    }
  },
  "$defs": {
    "slug": {"type": "string", "pattern": "^[a-z][a-z0-9_\\-]{1,63}$"},
    "stringList": {"type": "array", "items": {"type": "string"}},
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "repository", "layer", "integration", "runtime", "capabilities",
        "strengths", "limitations", "acceptance", "status"
      ],
      "properties": {
        "id": {"$ref": "#/$defs/slug"},
        "repository": {"type": "string", "format": "uri", "pattern": "^https://github\\.com/"},
        "layer": {"type": "string", "enum": ["browser", "desktop_visual", "desktop_windows", "terminal_execution", "code_engineering", "desktop_replay", "mobile", "reverse_engineering"]},
        "integration": {"type": "string", "enum": ["skill+connector", "connector", "app+connector", "mcp+connector", "mcp", "cli+connector", "vision-service"]},
        "runtime": {"$ref": "#/$defs/stringList", "minItems": 1},
        "capabilities": {"$ref": "#/$defs/stringList", "minItems": 1},
        "strengths": {"$ref": "#/$defs/stringList", "minItems": 1},
        "limitations": {"$ref": "#/$defs/stringList", "minItems": 1},
        "acceptance": {"$ref": "#/$defs/stringList", "minItems": 1},
        "status": {"type": "string", "enum": ["candidate", "probed", "session-accepted", "task-tested", "retired"]},
        "source_note": {"type": "string"},
        "license_note": {"type": "string"}
      }
    }
  }
}
